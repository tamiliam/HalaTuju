# A5 replay image (design 3.7). Built BY HAND with Cloud Build on the owner's yes; never deployed as a service.
# The build context is prepared by the owner-steps doc (docs/plans/2026-11-13-a5-replay-owner-steps.md):
#   old/halatuju_api   git archive of v3.1.0 (commit 442b21f4d), old/COMMIT
#   new/halatuju_api   git archive of the live main commit,     new/COMMIT
#   harness/replay     this package (apps/scholarship/eval/replay), as the top-level package `replay`
# No key, no database URL and no credential is baked in. The job gets REPLAY_DATABASE_URL from its one secret.
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    TZ=UTC \
    DJANGO_SETTINGS_MODULE=replay.settings

RUN apt-get update && apt-get install -y --no-install-recommends gcc libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Each tree with its OWN venv from its OWN lock (library versions moved between v3.1.0 and main).
COPY old/ /replay/old/
COPY new/ /replay/new/
RUN python -m venv /replay/old/venv && /replay/old/venv/bin/pip install --no-cache-dir -r /replay/old/halatuju_api/requirements.lock
RUN python -m venv /replay/new/venv && /replay/new/venv/bin/pip install --no-cache-dir -r /replay/new/halatuju_api/requirements.lock

COPY harness/ /replay/harness/

# The build FAILS if any engine path does not resolve in its tree (no URL here: in-memory SQLite, no query).
RUN cd /replay/old/halatuju_api && PYTHONPATH=/replay/harness:/replay/old/halatuju_api \
    /replay/old/venv/bin/python -m replay.engine_map --side old
RUN cd /replay/new/halatuju_api && PYTHONPATH=/replay/harness:/replay/new/halatuju_api \
    /replay/new/venv/bin/python -m replay.engine_map --side new

# The parent runs in the new tree's venv; it starts the three children itself.
WORKDIR /replay/new/halatuju_api
ENV PYTHONPATH=/replay/harness:/replay/new/halatuju_api
ENTRYPOINT ["/replay/new/venv/bin/python", "-m", "replay.parent"]
